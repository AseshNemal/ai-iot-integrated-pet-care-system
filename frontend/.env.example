# Backend API base URL. Leave unset for local dev (defaults to
# http://localhost:8090); set to your deployed backend's URL in production.
REACT_APP_API_BASE_URL=http://localhost:8090

# Google Maps
REACT_APP_GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Firebase Web app (Firebase Console -> Project settings -> Your apps -> SDK setup and configuration)
REACT_APP_FIREBASE_API_KEY=<your-firebase-web-api-key>
REACT_APP_FIREBASE_AUTH_DOMAIN=<your-project-id>.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://<your-database-name>.firebasedatabase.app
REACT_APP_FIREBASE_PROJECT_ID=<your-firebase-project-id>
REACT_APP_FIREBASE_STORAGE_BUCKET=<your-storage-bucket>
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=<your-messaging-sender-id>
REACT_APP_FIREBASE_APP_ID=<your-web-app-id>
REACT_APP_FIREBASE_MEASUREMENT_ID=<your-measurement-id>

# IoT simulator UI (SE4030 test/demo aid, optional, off by default — see docs/IOT_SIMULATOR.md)
# Shows "Create Simulator Device" and Start/Stop controls on a pet's tracker
# card. Requires the backend's ENABLE_IOT_SIMULATOR=true to actually work.
# Leave unset/false in production.
REACT_APP_ENABLE_IOT_SIMULATOR_UI=false
