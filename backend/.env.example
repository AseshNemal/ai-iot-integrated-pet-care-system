# Server
PORT=8090
NODE_ENV=development

# Database
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<database>

# Frontend
FRONTEND_URL=http://localhost:3000

# Session / Authentication
SESSION_SECRET=<generate-a-long-random-secret>
JWT_SECRET=<generate-a-long-random-secret>

# Google OAuth
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_REDIRECT_URL=http://localhost:8090/auth/google/callback

# AI
GEMINI_API_KEY=<your-gemini-api-key>

# IoT simulator (SE4030 test/demo aid, optional, off by default — see docs/IOT_SIMULATOR.md)
# Only takes effect when NODE_ENV is not "production", regardless of this flag.
ENABLE_IOT_SIMULATOR=false

# ingestion (default): simulator POSTs a signed telemetry envelope to IOT_SIMULATOR_INGEST_URL,
#   replacing only the physical micro:bit/SIM800L device, the same as the real (authenticated)
#   Cloudflare Worker ingestion path — see V28-iot-telemetry-authentication.md.
# direct-firebase: simulator writes straight to the Firebase Realtime Database, bypassing the
#   Worker/ingestion endpoint (and its authentication) — a local dashboard-testing fallback only.
IOT_SIMULATOR_MODE=ingestion
IOT_SIMULATOR_INGEST_URL=

# Required when IOT_SIMULATOR_MODE=ingestion (SE4030 V28 telemetry-authentication remediation).
# Shared HMAC secret the simulator signs telemetry with; must match the Worker's own
# INGEST_SHARED_SECRET (a Cloudflare Worker secret, configured in the Cloudflare dashboard, not here).
# This is a *shared* ingestion secret by design for the simulator (it mints arbitrary ad-hoc device
# IDs for testing) — it does not provide true per-device identity. The one real physical tracker
# should instead get its own entry in the Worker's DEVICE_SECRETS KV binding. See
# security-assessment/remediation/V28-iot-telemetry-authentication.md for the full design and
# documented limitation.
IOT_SIMULATOR_DEVICE_SECRET=

# Only used when IOT_SIMULATOR_MODE=direct-firebase.
IOT_SIMULATOR_FIREBASE_DATABASE_URL=https://<your-database-name>.firebasedatabase.app
IOT_SIMULATOR_FIREBASE_DATABASE_SECRET=

# Pet Tracker access-control fix (SE4030 V28 remediation).
# Server-side-only Realtime Database read used by GET /pet/tracker/:deviceId,
# which the frontend calls only after the caller is authenticated and the
# requested device is confirmed to belong to one of their pets. Usually the
# same database as IOT_SIMULATOR_FIREBASE_DATABASE_URL above; falls back to it
# if unset. FIREBASE_RTDB_SECRET is optional and falls back to
# IOT_SIMULATOR_FIREBASE_DATABASE_SECRET.
FIREBASE_RTDB_URL=https://<your-database-name>.firebasedatabase.app
FIREBASE_RTDB_SECRET=
